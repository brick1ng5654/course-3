// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "02/18/2026 18:37:29"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    lab02
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module lab02_vlg_sample_tst(
	X,
	sampler_tx
);
input [3:0] X;
output sampler_tx;

reg sample;
time current_time;
always @(X)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module lab02_vlg_check_tst (
	out_1,
	out_2,
	out_D,
	out_M,
	sampler_rx
);
input  out_1;
input  out_2;
input  out_D;
input  out_M;
input sampler_rx;

reg  out_1_expected;
reg  out_2_expected;
reg  out_D_expected;
reg  out_M_expected;

reg  out_1_prev;
reg  out_2_prev;
reg  out_D_prev;
reg  out_M_prev;

reg  out_1_expected_prev;
reg  out_2_expected_prev;
reg  out_D_expected_prev;
reg  out_M_expected_prev;

reg  last_out_1_exp;
reg  last_out_2_exp;
reg  last_out_D_exp;
reg  last_out_M_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:4] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 4'b1;
end

// update real /o prevs

always @(trigger)
begin
	out_1_prev = out_1;
	out_2_prev = out_2;
	out_D_prev = out_D;
	out_M_prev = out_M;
end

// update expected /o prevs

always @(trigger)
begin
	out_1_expected_prev = out_1_expected;
	out_2_expected_prev = out_2_expected;
	out_D_expected_prev = out_D_expected;
	out_M_expected_prev = out_M_expected;
end



// expected out_1
initial
begin
	out_1_expected = 1'bX;
end 

// expected out_2
initial
begin
	out_2_expected = 1'bX;
end 

// expected out_D
initial
begin
	out_D_expected = 1'bX;
end 

// expected out_M
initial
begin
	out_M_expected = 1'bX;
end 
// generate trigger
always @(out_1_expected or out_1 or out_2_expected or out_2 or out_D_expected or out_D or out_M_expected or out_M)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected out_1 = %b | expected out_2 = %b | expected out_D = %b | expected out_M = %b | ",out_1_expected_prev,out_2_expected_prev,out_D_expected_prev,out_M_expected_prev);
	$display("| real out_1 = %b | real out_2 = %b | real out_D = %b | real out_M = %b | ",out_1_prev,out_2_prev,out_D_prev,out_M_prev);
`endif
	if (
		( out_1_expected_prev !== 1'bx ) && ( out_1_prev !== out_1_expected_prev )
		&& ((out_1_expected_prev !== last_out_1_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port out_1 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", out_1_expected_prev);
		$display ("     Real value = %b", out_1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_out_1_exp = out_1_expected_prev;
	end
	if (
		( out_2_expected_prev !== 1'bx ) && ( out_2_prev !== out_2_expected_prev )
		&& ((out_2_expected_prev !== last_out_2_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port out_2 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", out_2_expected_prev);
		$display ("     Real value = %b", out_2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_out_2_exp = out_2_expected_prev;
	end
	if (
		( out_D_expected_prev !== 1'bx ) && ( out_D_prev !== out_D_expected_prev )
		&& ((out_D_expected_prev !== last_out_D_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port out_D :: @time = %t",  $realtime);
		$display ("     Expected value = %b", out_D_expected_prev);
		$display ("     Real value = %b", out_D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_out_D_exp = out_D_expected_prev;
	end
	if (
		( out_M_expected_prev !== 1'bx ) && ( out_M_prev !== out_M_expected_prev )
		&& ((out_M_expected_prev !== last_out_M_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port out_M :: @time = %t",  $realtime);
		$display ("     Expected value = %b", out_M_expected_prev);
		$display ("     Real value = %b", out_M_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_out_M_exp = out_M_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#800000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module lab02_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [3:0] X;
// wires                                               
wire out_1;
wire out_2;
wire out_D;
wire out_M;

wire sampler;                             

// assign statements (if any)                          
lab02 i1 (
// port map - connection between master ports and signals/registers   
	.out_1(out_1),
	.out_2(out_2),
	.out_D(out_D),
	.out_M(out_M),
	.X(X)
);
// X[ 3 ]
always
begin
	X[3] = 1'b0;
	X[3] = #400000 1'b1;
	#400000;
end 
// X[ 2 ]
always
begin
	X[2] = 1'b0;
	X[2] = #200000 1'b1;
	#200000;
end 
// X[ 1 ]
always
begin
	X[1] = 1'b0;
	X[1] = #100000 1'b1;
	#100000;
end 
// X[ 0 ]
always
begin
	X[0] = 1'b0;
	X[0] = #50000 1'b1;
	#50000;
end 

lab02_vlg_sample_tst tb_sample (
	.X(X),
	.sampler_tx(sampler)
);

lab02_vlg_check_tst tb_out(
	.out_1(out_1),
	.out_2(out_2),
	.out_D(out_D),
	.out_M(out_M),
	.sampler_rx(sampler)
);
endmodule

