// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "02/18/2026 18:20:10"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    lab04_RS
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module lab04_RS_vlg_sample_tst(
	Clk,
	CLRN,
	PRN,
	sampler_tx
);
input  Clk;
input  CLRN;
input  PRN;
output sampler_tx;

reg sample;
time current_time;
always @(Clk or CLRN or PRN)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module lab04_RS_vlg_check_tst (
	C,
	R,
	RS_res,
	S,
	X,
	sampler_rx
);
input  C;
input  R;
input  RS_res;
input  S;
input [3:0] X;
input sampler_rx;

reg  C_expected;
reg  R_expected;
reg  RS_res_expected;
reg  S_expected;
reg [3:0] X_expected;

reg  C_prev;
reg  R_prev;
reg  RS_res_prev;
reg  S_prev;
reg [3:0] X_prev;

reg  C_expected_prev;
reg  R_expected_prev;
reg  RS_res_expected_prev;
reg  S_expected_prev;
reg [3:0] X_expected_prev;

reg  last_C_exp;
reg  last_R_exp;
reg  last_RS_res_exp;
reg  last_S_exp;
reg [3:0] last_X_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:5] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 5'b1;
end

// update real /o prevs

always @(trigger)
begin
	C_prev = C;
	R_prev = R;
	RS_res_prev = RS_res;
	S_prev = S;
	X_prev = X;
end

// update expected /o prevs

always @(trigger)
begin
	C_expected_prev = C_expected;
	R_expected_prev = R_expected;
	RS_res_expected_prev = RS_res_expected;
	S_expected_prev = S_expected;
	X_expected_prev = X_expected;
end


// expected X[ 3 ]
initial
begin
	X_expected[3] = 1'b0;
	X_expected[3] = #80000 1'b1;
	X_expected[3] = #80000 1'b0;
	X_expected[3] = #80000 1'b1;
	X_expected[3] = #74000 1'b0;
end 
// expected X[ 2 ]
initial
begin
	repeat(3)
	begin
		X_expected[2] = 1'b0;
		X_expected[2] = #40000 1'b1;
		# 40000;
	end
	X_expected[2] = 1'b0;
	X_expected[2] = #40000 1'b1;
	X_expected[2] = #34000 1'b0;
end 
// expected X[ 1 ]
initial
begin
	repeat(7)
	begin
		X_expected[1] = 1'b0;
		X_expected[1] = #20000 1'b1;
		# 20000;
	end
	X_expected[1] = 1'b0;
	X_expected[1] = #20000 1'b1;
	X_expected[1] = #14000 1'b0;
end 
// expected X[ 0 ]
initial
begin
	repeat(15)
	begin
		X_expected[0] = 1'b0;
		X_expected[0] = #10000 1'b1;
		# 10000;
	end
	X_expected[0] = 1'b0;
	X_expected[0] = #10000 1'b1;
	X_expected[0] = #4000 1'b0;
end 

// expected R
initial
begin
	R_expected = 1'bX;
	R_expected = #314000 1'b0;
end 

// expected S
initial
begin
	S_expected = 1'bX;
	S_expected = #314000 1'b0;
end 

// expected C
initial
begin
	C_expected = 1'bX;
	C_expected = #314000 1'b0;
end 

// expected RS_res
initial
begin
	RS_res_expected = 1'bX;
	RS_res_expected = #314000 1'b0;
end 
// generate trigger
always @(C_expected or C or R_expected or R or RS_res_expected or RS_res or S_expected or S or X_expected or X)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected C = %b | expected R = %b | expected RS_res = %b | expected S = %b | expected X = %b | ",C_expected_prev,R_expected_prev,RS_res_expected_prev,S_expected_prev,X_expected_prev);
	$display("| real C = %b | real R = %b | real RS_res = %b | real S = %b | real X = %b | ",C_prev,R_prev,RS_res_prev,S_prev,X_prev);
`endif
	if (
		( C_expected_prev !== 1'bx ) && ( C_prev !== C_expected_prev )
		&& ((C_expected_prev !== last_C_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port C :: @time = %t",  $realtime);
		$display ("     Expected value = %b", C_expected_prev);
		$display ("     Real value = %b", C_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_C_exp = C_expected_prev;
	end
	if (
		( R_expected_prev !== 1'bx ) && ( R_prev !== R_expected_prev )
		&& ((R_expected_prev !== last_R_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port R :: @time = %t",  $realtime);
		$display ("     Expected value = %b", R_expected_prev);
		$display ("     Real value = %b", R_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_R_exp = R_expected_prev;
	end
	if (
		( RS_res_expected_prev !== 1'bx ) && ( RS_res_prev !== RS_res_expected_prev )
		&& ((RS_res_expected_prev !== last_RS_res_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port RS_res :: @time = %t",  $realtime);
		$display ("     Expected value = %b", RS_res_expected_prev);
		$display ("     Real value = %b", RS_res_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_RS_res_exp = RS_res_expected_prev;
	end
	if (
		( S_expected_prev !== 1'bx ) && ( S_prev !== S_expected_prev )
		&& ((S_expected_prev !== last_S_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port S :: @time = %t",  $realtime);
		$display ("     Expected value = %b", S_expected_prev);
		$display ("     Real value = %b", S_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_S_exp = S_expected_prev;
	end
	if (
		( X_expected_prev[0] !== 1'bx ) && ( X_prev[0] !== X_expected_prev[0] )
		&& ((X_expected_prev[0] !== last_X_exp[0]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port X[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", X_expected_prev);
		$display ("     Real value = %b", X_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_X_exp[0] = X_expected_prev[0];
	end
	if (
		( X_expected_prev[1] !== 1'bx ) && ( X_prev[1] !== X_expected_prev[1] )
		&& ((X_expected_prev[1] !== last_X_exp[1]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port X[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", X_expected_prev);
		$display ("     Real value = %b", X_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_X_exp[1] = X_expected_prev[1];
	end
	if (
		( X_expected_prev[2] !== 1'bx ) && ( X_prev[2] !== X_expected_prev[2] )
		&& ((X_expected_prev[2] !== last_X_exp[2]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port X[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", X_expected_prev);
		$display ("     Real value = %b", X_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_X_exp[2] = X_expected_prev[2];
	end
	if (
		( X_expected_prev[3] !== 1'bx ) && ( X_prev[3] !== X_expected_prev[3] )
		&& ((X_expected_prev[3] !== last_X_exp[3]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port X[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", X_expected_prev);
		$display ("     Real value = %b", X_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_X_exp[3] = X_expected_prev[3];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#320000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module lab04_RS_vlg_vec_tst();
// constants                                           
// general purpose registers
reg Clk;
reg CLRN;
reg PRN;
// wires                                               
wire C;
wire R;
wire RS_res;
wire S;
wire [3:0] X;

wire sampler;                             

// assign statements (if any)                          
lab04_RS i1 (
// port map - connection between master ports and signals/registers   
	.C(C),
	.Clk(Clk),
	.CLRN(CLRN),
	.PRN(PRN),
	.R(R),
	.RS_res(RS_res),
	.S(S),
	.X(X)
);

// Clk
initial
begin
	repeat(31)
	begin
		Clk = 1'b0;
		Clk = #5000 1'b1;
		# 5000;
	end
	Clk = 1'b0;
end 

// PRN
initial
begin
	PRN = 1'b1;
	PRN = #20000 1'b0;
	PRN = #10000 1'b1;
	PRN = #284000 1'b0;
end 

// CLRN
initial
begin
	CLRN = 1'b0;
	CLRN = #10000 1'b1;
	CLRN = #304000 1'b0;
end 

lab04_RS_vlg_sample_tst tb_sample (
	.Clk(Clk),
	.CLRN(CLRN),
	.PRN(PRN),
	.sampler_tx(sampler)
);

lab04_RS_vlg_check_tst tb_out(
	.C(C),
	.R(R),
	.RS_res(RS_res),
	.S(S),
	.X(X),
	.sampler_rx(sampler)
);
endmodule

