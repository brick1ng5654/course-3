// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "02/18/2026 18:31:38"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    lab04
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module lab04_vlg_sample_tst(
	Clk,
	PRN,
	sampler_tx
);
input  Clk;
input  PRN;
output sampler_tx;

reg sample;
time current_time;
always @(Clk or PRN)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module lab04_vlg_check_tst (
	C,
	D,
	dinamic_D,
	static_D,
	X,
	sampler_rx
);
input  C;
input  D;
input  dinamic_D;
input  static_D;
input [3:0] X;
input sampler_rx;

reg  C_expected;
reg  D_expected;
reg  dinamic_D_expected;
reg  static_D_expected;
reg [3:0] X_expected;

reg  C_prev;
reg  D_prev;
reg  dinamic_D_prev;
reg  static_D_prev;
reg [3:0] X_prev;

reg  C_expected_prev;
reg  D_expected_prev;
reg  dinamic_D_expected_prev;
reg  static_D_expected_prev;
reg [3:0] X_expected_prev;

reg  last_C_exp;
reg  last_D_exp;
reg  last_dinamic_D_exp;
reg  last_static_D_exp;
reg [3:0] last_X_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:5] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 5'b1;
end

// update real /o prevs

always @(trigger)
begin
	C_prev = C;
	D_prev = D;
	dinamic_D_prev = dinamic_D;
	static_D_prev = static_D;
	X_prev = X;
end

// update expected /o prevs

always @(trigger)
begin
	C_expected_prev = C_expected;
	D_expected_prev = D_expected;
	dinamic_D_expected_prev = dinamic_D_expected;
	static_D_expected_prev = static_D_expected;
	X_expected_prev = X_expected;
end


// expected X[ 3 ]
initial
begin
	X_expected[3] = 1'b0;
	X_expected[3] = #400000 1'b1;
	X_expected[3] = #400000 1'b0;
end 
// expected X[ 2 ]
initial
begin
	repeat(2)
	begin
		X_expected[2] = 1'b0;
		X_expected[2] = #200000 1'b1;
		# 200000;
	end
	X_expected[2] = 1'b0;
end 
// expected X[ 1 ]
always
begin
	X_expected[1] = 1'b0;
	X_expected[1] = #100000 1'b1;
	#100000;
end 
// expected X[ 0 ]
always
begin
	X_expected[0] = 1'b0;
	X_expected[0] = #50000 1'b1;
	#50000;
end 

// expected C
initial
begin
	C_expected = 1'bX;
end 

// expected D
initial
begin
	D_expected = 1'bX;
end 

// expected dinamic_D
initial
begin
	dinamic_D_expected = 1'bX;
end 

// expected static_D
initial
begin
	static_D_expected = 1'bX;
end 
// generate trigger
always @(C_expected or C or D_expected or D or dinamic_D_expected or dinamic_D or static_D_expected or static_D or X_expected or X)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected C = %b | expected D = %b | expected dinamic_D = %b | expected static_D = %b | expected X = %b | ",C_expected_prev,D_expected_prev,dinamic_D_expected_prev,static_D_expected_prev,X_expected_prev);
	$display("| real C = %b | real D = %b | real dinamic_D = %b | real static_D = %b | real X = %b | ",C_prev,D_prev,dinamic_D_prev,static_D_prev,X_prev);
`endif
	if (
		( C_expected_prev !== 1'bx ) && ( C_prev !== C_expected_prev )
		&& ((C_expected_prev !== last_C_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port C :: @time = %t",  $realtime);
		$display ("     Expected value = %b", C_expected_prev);
		$display ("     Real value = %b", C_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_C_exp = C_expected_prev;
	end
	if (
		( D_expected_prev !== 1'bx ) && ( D_prev !== D_expected_prev )
		&& ((D_expected_prev !== last_D_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port D :: @time = %t",  $realtime);
		$display ("     Expected value = %b", D_expected_prev);
		$display ("     Real value = %b", D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_D_exp = D_expected_prev;
	end
	if (
		( dinamic_D_expected_prev !== 1'bx ) && ( dinamic_D_prev !== dinamic_D_expected_prev )
		&& ((dinamic_D_expected_prev !== last_dinamic_D_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port dinamic_D :: @time = %t",  $realtime);
		$display ("     Expected value = %b", dinamic_D_expected_prev);
		$display ("     Real value = %b", dinamic_D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_dinamic_D_exp = dinamic_D_expected_prev;
	end
	if (
		( static_D_expected_prev !== 1'bx ) && ( static_D_prev !== static_D_expected_prev )
		&& ((static_D_expected_prev !== last_static_D_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port static_D :: @time = %t",  $realtime);
		$display ("     Expected value = %b", static_D_expected_prev);
		$display ("     Real value = %b", static_D_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_static_D_exp = static_D_expected_prev;
	end
	if (
		( X_expected_prev[0] !== 1'bx ) && ( X_prev[0] !== X_expected_prev[0] )
		&& ((X_expected_prev[0] !== last_X_exp[0]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port X[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", X_expected_prev);
		$display ("     Real value = %b", X_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_X_exp[0] = X_expected_prev[0];
	end
	if (
		( X_expected_prev[1] !== 1'bx ) && ( X_prev[1] !== X_expected_prev[1] )
		&& ((X_expected_prev[1] !== last_X_exp[1]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port X[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", X_expected_prev);
		$display ("     Real value = %b", X_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_X_exp[1] = X_expected_prev[1];
	end
	if (
		( X_expected_prev[2] !== 1'bx ) && ( X_prev[2] !== X_expected_prev[2] )
		&& ((X_expected_prev[2] !== last_X_exp[2]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port X[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", X_expected_prev);
		$display ("     Real value = %b", X_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_X_exp[2] = X_expected_prev[2];
	end
	if (
		( X_expected_prev[3] !== 1'bx ) && ( X_prev[3] !== X_expected_prev[3] )
		&& ((X_expected_prev[3] !== last_X_exp[3]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port X[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", X_expected_prev);
		$display ("     Real value = %b", X_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_X_exp[3] = X_expected_prev[3];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module lab04_vlg_vec_tst();
// constants                                           
// general purpose registers
reg Clk;
reg PRN;
// wires                                               
wire C;
wire D;
wire dinamic_D;
wire static_D;
wire [3:0] X;

wire sampler;                             

// assign statements (if any)                          
lab04 i1 (
// port map - connection between master ports and signals/registers   
	.C(C),
	.Clk(Clk),
	.D(D),
	.dinamic_D(dinamic_D),
	.PRN(PRN),
	.static_D(static_D),
	.X(X)
);

// PRN
initial
begin
	PRN = 1'b1;
end 

// Clk
always
begin
	Clk = 1'b0;
	Clk = #5000 1'b1;
	#5000;
end 

lab04_vlg_sample_tst tb_sample (
	.Clk(Clk),
	.PRN(PRN),
	.sampler_tx(sampler)
);

lab04_vlg_check_tst tb_out(
	.C(C),
	.D(D),
	.dinamic_D(dinamic_D),
	.static_D(static_D),
	.X(X),
	.sampler_rx(sampler)
);
endmodule

